# Salesforce auth: choose ONE of the two options below.
#
# Option 1: Session ID (for local testing only, session expires)
#   Get via: sf org display --target-org olami --json
# SF_SESSION_ID=00D...
# SF_INSTANCE_URL=https://yourorg.my.salesforce.com
#
# Option 2: OAuth refresh token (for production on Railway)
SF_CLIENT_ID=consumer_key_from_connected_app
SF_CLIENT_SECRET=consumer_secret_from_connected_app
SF_REFRESH_TOKEN=long_lived_refresh_token
SF_INSTANCE_URL=https://yourorg.my.salesforce.com

# Bearer token required for all requests from claude.ai
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=long_random_string
